node_modules/
# package-lock.json is intentionally TRACKED: CI uses `npm ci` for reproducible installs.
.DS_Store
setup/

# Generated by test/coverage/Python runs — never source
.nyc_output/
coverage/
test-results/
__pycache__/
*.pyc

# Runtime state — generated, not source
docs/planning/
plugins/reflection-system/state/
# Claude Code plugin runtime state (caches, generated artifacts, marketplace data)
plugins/cache/
plugins/data/
plugins/marketplaces/
# Wiki runtime content (created by /wiki-init, not tracked)
.wiki/
raw/

# Benchmark results — generated, not source
results/*.json
!results/.gitkeep

# Test artifacts — regenerated on every `npm test` run
test/artifacts/
.worktrees/

# LLM-bench live-run output — captured for post-hoc inspection, not source
test/plugins/planning-suite/llm-bench/runs/
