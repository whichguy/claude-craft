#!/bin/bash

# Pre-push hook: run the checks CI will run, scoped to what this push changes.
#
# Most red runs on main were regressions that `tools/ci.sh` would have caught in under a
# minute; this makes pushing to main as safe as pushing a PR. CI still runs everything.
#
#   SKIP_PREPUSH=1 git push     skip once (or: git push --no-verify)
#
# It checks your WORKING TREE at HEAD, so it only gates pushes of the checked-out branch.

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

[ -n "${SKIP_PREPUSH:-}" ] && { echo -e "${YELLOW}pre-push: skipped (SKIP_PREPUSH set)${NC}"; exit 0; }

REPO_ROOT=$(git rev-parse --show-toplevel)
CI="$REPO_ROOT/tools/ci.sh"
[ -x "$CI" ] || exit 0
if [ ! -x "$REPO_ROOT/node_modules/.bin/mocha" ]; then
    echo -e "${YELLOW}pre-push: node_modules missing (run: npm ci) — skipping local CI${NC}"
    exit 0
fi

ZERO=0000000000000000000000000000000000000000
HEAD_SHA=$(git rev-parse HEAD)
BASE=""
PUSHING_HEAD=false

# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed.
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue                      # deleting a ref
    [ "$local_sha" = "$HEAD_SHA" ] || continue                  # not the checked-out branch
    PUSHING_HEAD=true
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        BASE="$remote_sha"
    else
        BASE=$(git merge-base "$local_sha" origin/main 2>/dev/null)   # new branch: diff from where it forked
    fi
done

if [ "$PUSHING_HEAD" != "true" ]; then
    echo -e "${YELLOW}pre-push: not pushing the checked-out branch — local CI skipped (CI will run it)${NC}"
    exit 0
fi

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo -e "${YELLOW}pre-push: working tree has uncommitted changes — results reflect them, not just the commits being pushed${NC}"
fi

echo -e "${BLUE}🚦 pre-push: tools/ci.sh pre-push (SKIP_PREPUSH=1 to skip)${NC}"
if [ -n "$BASE" ]; then
    "$CI" pre-push --base "$BASE"
else
    "$CI" pre-push
fi
RC=$?

if [ "$RC" -ne 0 ]; then
    echo -e "${RED}🚨 PUSH BLOCKED: local CI failed. Fix it, or SKIP_PREPUSH=1 git push to override.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ local CI passed${NC}"
exit 0
