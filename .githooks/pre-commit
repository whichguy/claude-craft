#!/bin/bash

# Pre-commit hook: secret detection + marketplace lints.
#
# The secret-scan POLICY lives in tools/scan-secrets.sh and is shared with CI
# (tools/ci.sh): code files block the commit, tests/docs only warn. This hook used
# to call the engine (tools/simple-secrets-scan.sh) with `false`, which is
# "report-only, always exit 0" — so it printed "passed" and could never block.
# It now scans the STAGED content (the index), not the working tree, because the
# two differ under `git add -p`, and it includes renamed files (R): a rename+edit is not A or M.

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🛡️  Running pre-commit secret scan...${NC}"

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
SECURITY_SCANNER="$REPO_ROOT/tools/scan-secrets.sh"

# Check if security scanner exists
if [ ! -x "$SECURITY_SCANNER" ]; then
    echo -e "${YELLOW}⚠️  Security scanner not found, skipping scan${NC}"
    exit 0
fi

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✅ No files staged for commit${NC}"
    exit 0
fi

echo -e "${BLUE}📁 Files staged for commit:${NC}"
echo "$STAGED_FILES" | sed 's/^/  /'

# Materialise the staged blobs under their repo-relative paths so the scanner's
# path-based policy (code vs test/docs) sees exactly what would be committed.
SCAN_DIR=$(mktemp -d)
trap 'rm -rf "$SCAN_DIR"' EXIT
mkdir -p "$SCAN_DIR/tree"
git diff --cached -z --name-only --diff-filter=ACMR > "$SCAN_DIR/list"
while IFS= read -r -d '' file; do
    mkdir -p "$SCAN_DIR/tree/$(dirname "$file")"
    git show ":$file" > "$SCAN_DIR/tree/$file" 2>/dev/null
done < "$SCAN_DIR/list"

SCAN_OUTPUT=$( cd "$SCAN_DIR/tree" && xargs -0 "$SECURITY_SCANNER" < "$SCAN_DIR/list" 2>&1 )
SCAN_RC=$?

# Test/doc files only warn (they legitimately hold fake keys).
echo "$SCAN_OUTPUT" | grep '^warn:' | while IFS= read -r line; do
    echo -e "${YELLOW}⚠️  ${line#warn:    }${NC}"
done

if [ "$SCAN_RC" -ne 0 ]; then
    CRITICAL_FILES=$(echo "$SCAN_OUTPUT" | sed -n 's/^BLOCKED: \([^ ]*\) .*/\1/p' | sed 's/^/\\n  /' | tr -d '\n')
    echo -e "${RED}🚨 COMMIT BLOCKED: Secrets detected in staged files!${NC}"
    echo -e "${RED}Critical files:${CRITICAL_FILES}${NC}"
    echo ""
    echo -e "${YELLOW}💡 To fix this:${NC}"
    echo -e "${YELLOW}   1. Remove hardcoded secrets from the files above${NC}"
    echo -e "${YELLOW}   2. Use environment variables: \${API_KEY}${NC}"
    echo -e "${YELLOW}   3. Add secrets to .env file (ensure .env is in .gitignore)${NC}"
    echo -e "${YELLOW}   4. For test files, use obviously fake values${NC}"
    echo ""
    echo -e "${YELLOW}🔧 Quick commands:${NC}"
    echo -e "${YELLOW}   git reset HEAD <file>     # Unstage file${NC}"
    echo -e "${YELLOW}   git stash                 # Stash changes${NC}"

    # Log the prevented commit
    echo "$(date '+%Y-%m-%d %H:%M:%S') - PRE-COMMIT: Blocked commit with secrets in: $CRITICAL_FILES" >> ~/.git-security.log

    exit 1
else
    echo -e "${GREEN}✅ Pre-commit secret scan passed - no secrets detected${NC}"
fi

# Marketplace + namespacing lints (only when relevant files changed)
if echo "$STAGED_FILES" | grep -qE '^(plugins/|\.claude-plugin/|tools/sync-bundled-tools\.sh)'; then
    if [ -x "$REPO_ROOT/tools/lint-marketplace.sh" ]; then
        if ! ( cd "$REPO_ROOT" && ./tools/lint-marketplace.sh ) >/dev/null 2>&1; then
            echo -e "${RED}🚨 COMMIT BLOCKED: tools/lint-marketplace.sh failed.${NC}"
            echo -e "${YELLOW}   Re-run it for details:  ./tools/lint-marketplace.sh${NC}"
            exit 1
        fi
        echo -e "${GREEN}✅ Marketplace lint passed${NC}"
    fi
    if [ -x "$REPO_ROOT/tools/lint-namespacing.sh" ]; then
        if ! ( cd "$REPO_ROOT" && ./tools/lint-namespacing.sh ) >/dev/null 2>&1; then
            echo -e "${RED}🚨 COMMIT BLOCKED: tools/lint-namespacing.sh found bare cross-bundle refs.${NC}"
            echo -e "${YELLOW}   Re-run it for details:  ./tools/lint-namespacing.sh${NC}"
            exit 1
        fi
        echo -e "${GREEN}✅ Namespacing lint passed${NC}"
    fi
fi

exit 0
